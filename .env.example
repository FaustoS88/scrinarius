# Copy to .env (git-ignored). docker compose reads it; the API run with npm loads it in a subshell, so compose never picks up an old key from your shell:
#   (set -a; . ../.env; set +a; npm run start:dev)
# OpenSearch requires a strong admin password, not easy to guess: at least 8 characters with upper and lower case, a digit and a symbol.
# Keep the value in single quotes, so the shell and docker compose both read it as written.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=''
# Written by scripts/setup-opensearch.sh (rerun it to replace the key): the backend's API key and its id.
OPENSEARCH_API_KEY=''
OPENSEARCH_API_KEY_ID=''
